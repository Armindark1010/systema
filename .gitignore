node_modules
.nuxt
.output
.data
dist
.env
.DS_Store
*.log

# Capacitor / Android local and generated build files
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
*.keystore
*.jks

# ---- AI model weights (Phase 15) ----
# Candidate models run from ~15 MB to ~620 MB. They are side-loaded per
# device (adb push to Android/data/com.systema.music/files/models/),
# never committed: git handles opaque binaries badly and the repo would
# grow permanently with every candidate tried.
#
# The one exception is deliberately NOT ignored — the 423-byte
# arithmetic test model at
# android/app/src/main/assets/models/systema-test-model.onnx — because
# it has no learned weights and the integration test needs it present.
*.pt
*.pth
*.safetensors
*.tflite
*.ckpt
*.h5
*.pb
android/app/src/main/assets/models/*.onnx
!android/app/src/main/assets/models/systema-test-model.onnx

# ---- Phase 19 distillation artifacts ----
# Student ONNX graphs and teacher caches are REGENERATED by
# scripts/phase19/distillation/train_student.py --export-onnx-dir.
# They are build outputs, not source: the training script plus its
# recorded seed reproduces them exactly, so committing them would add
# megabytes of opaque binary for no recoverable information.
scripts/phase19/**/*.onnx
scripts/phase19/**/*.onnx.data
scripts/phase19/**/teacher_cache/

# Python bytecode from the Phase 19 offline pipeline
__pycache__/
*.pyc
